[Unit]
Description=Keylightd camera frame monitor
Documentation=https://github.com/moritzheiber/keylightd
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/keylightd camera-monitor
Restart=on-failure
RestartSec=2
RuntimeDirectory=keylightd
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/sys/kernel/tracing /run/keylightd
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
