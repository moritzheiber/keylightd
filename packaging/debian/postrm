#!/bin/sh
set -eu

if [ "${1:-}" = "purge" ]; then
    deb-systemd-helper purge keylightd-camera.service >/dev/null || true
    deb-systemd-helper --user purge keylightd.service >/dev/null || true
fi

if [ -z "${DPKG_ROOT:-}" ] && [ "${1:-}" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
    deb-systemd-invoke --user --no-dbus daemon-reload >/dev/null || true
fi
